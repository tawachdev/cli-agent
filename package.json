{
  "name": "cli-agent",
  "version": "0.1.18",
  "private": true,
  "type": "module",
  "bin": {
    "mimon": "./bin/agent.ts"
  },
  "scripts": {
    "cli": "bun run bin/agent.ts",
    "dev": "bun run src/engine/app/bootstrap.ts",
    "stage": "bun run scripts/stage.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build:bin": "bun build --compile bin/agent.ts --outfile dist/agent",
    "lint": "biome lint --error-on-warnings",
    "check": "bun run typecheck && bun run lint && bun test"
  },
  "dependencies": {
    "hono": "^4.13.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2",
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  }
}
